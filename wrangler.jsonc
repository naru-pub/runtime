// The runtime as naru-dev runs it under workerd (src/dev.ts): only bundled by
// wrangler (dev/scripts/build-worker.mjs), never deployed.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "naru-runtime-dev",
  "main": "src/dev.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "alias": { "acorn": "./node_modules/acorn/dist/acorn.mjs" },
  "durable_objects": {
    "bindings": [{ "name": "SITES", "class_name": "SiteData" }],
  },
  // Each release of a site's code in an isolate of its own (src/functions.ts).
  "worker_loaders": [{ "binding": "LOADER" }],
  "workers_dev": false,
}
